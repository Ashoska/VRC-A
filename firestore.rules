rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       Helpers
       ========================= */

    function signedIn() {
      return request.auth != null;
    }

    function ownerUid() {
      return exists(/databases/$(database)/documents/config/app)
        ? get(/databases/$(database)/documents/config/app).data.ownerUid
        : "";
    }

    function isOwner() {
      return signedIn() && ownerUid() == request.auth.uid;
    }

    function isValidDeviceHashString(v) {
      return (v is string) && v.size() >= 16 && v.size() <= 128;
    }

    function ownerOnlyUserKeys() {
      return [
        "warned", "warnReason",
        "banned", "banReason",
        "watcherActiveAt",
        "killSignal",
        "logoutVrchatAt", "logoutDiscordAt",
        "targetedUpdateUrl", "targetedUpdateNotes",
        // Admin self-invite signal (admin asks the user's app to invite the admin
        // into the user's current instance). Admin-only write.
        "selfInviteReqId", "selfInviteAdminId", "selfInviteLocation", "selfInviteAt",
        // Admin remote Start/Stop of a device's OSC sending (device-only). Admin-only write.
        "oscCommandAt", "oscCommand"
      ];
    }

    function selfMutableKeys() {
      return [
        // Identity / debug
        "lastActiveAt", "lastSeenAt", "updatedAt",
        "appId", "adminBuild", "versionName", "versionCode",
        "docId", "docIdType",
        "authUid", "uid", "currentUid",
        "deviceHash",
        "tosAcceptedVersion", "tosAcceptedAt",
        "displayName",

        // App online status
        "isOnlineInApp", "offlineAt",

        // Pinned message
        "afkEnabled", "afkMessage",
        "afkPreset1", "afkPreset2", "afkPreset3",

        // Cycle
        "cycleEnabled", "cycleIntervalSeconds", "cycleLines", "cycleLinesText",
        "cyclePreset1", "cyclePreset2", "cyclePreset3", "cyclePreset4", "cyclePreset5",

        // Now Playing
        "spotifyEnabled", "spotifyDemoEnabled", "spotifyPreset",
        "nowPlayingDetected", "nowPlayingIsPlaying",
        "nowPlayingTitle", "nowPlayingArtist",

        // Output
        "activePackage",
        "combinedPreviewText",
        "cycleTrimWarning",
        // Master OSC Start/Stop gate (whether the chatbox is actually transmitting) —
        // display-only for the admin detail view; self-written, admin never sets it.
        "oscSending",

        // Time
        "timeEnabled", "timeMode",
        "lastReportedTime", "lastTimeUpdateAt",

        // Multi-IP slot selector (slot names/addresses are local-only DataStore)
        "activeIpSlot",

        // Self-invite handshake: the user's app echoes the admin's request id and
        // reports the outcome back so the admin's poll can surface it.
        "selfInviteAckReqId", "selfInviteStatus", "selfInviteError", "selfInviteStatusAt",

        // VRChat identity + presence (written by PipelineService when watched)
        "vrchatUserId", "vrchatDisplayName",
        "vrchatState", "vrchatStatus", "vrchatStatusDescription",
        "vrchatWorld", "vrchatLocation",
        "vrchatInstancePlayerCount", "vrchatInstanceCapacity",
        "vrchatPlatform", "vrchatAvatarThumb",
        "vrchatProfilePic",
        "vrchatIsOnline",
        "vrchatLastSyncAt", "vrchatAuthCookieValid",

        // Discord avatar URL (captured by DiscordRpcService, synced by self).
        // Used by the admin panel as a profile-picture fallback after VRChat+.
        "discordAvatarUrl",

        // Friends cache (kept ONLY so FieldValue.delete() cleanup is allowed
        // by the rules — never written with real data anymore, lives locally)
        "savedFriendIds", "savedFriendNames"
      ];
    }

    function deviceIdentityConsistent(deviceHash) {
      return request.resource.data.deviceHash == deviceHash
        && isValidDeviceHashString(request.resource.data.deviceHash)
        && (!("docId" in request.resource.data) || request.resource.data.docId == deviceHash)
        && (!("docIdType" in request.resource.data) || request.resource.data.docIdType in ["deviceHash", "authUid_fallback", "authUid"]);
    }

    function publicAuthConsistent() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.authUid == request.auth.uid
        && (!("currentUid" in request.resource.data) || request.resource.data.currentUid == request.auth.uid);
    }

    function isOwnerOfDeviceDoc(deviceHash) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(deviceHash))
        && get(/databases/$(database)/documents/users/$(deviceHash)).data.uid == request.auth.uid;
    }

    /* =========================
       USERS (DOC ID = deviceHash)
       ========================= */

    match /users/{deviceHash} {
      allow get:  if isOwner() || isOwnerOfDeviceDoc(deviceHash);
      allow list: if isOwner();

      allow create: if signedIn()
        && deviceIdentityConsistent(deviceHash)
        && publicAuthConsistent()
        && request.resource.data.keys().hasOnly(selfMutableKeys())
        && !request.resource.data.keys().hasAny(ownerOnlyUserKeys());

      allow update: if signedIn()
        && resource.data.deviceHash == deviceHash
        && deviceIdentityConsistent(deviceHash)
        && publicAuthConsistent()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(selfMutableKeys())
        && !request.resource.data.diff(resource.data).changedKeys().hasAny(ownerOnlyUserKeys());

      // Owner can update any field (ban, warn, edit presets, watcher, targeted updates).
      allow update: if isOwner()
        && request.resource.data.deviceHash == deviceHash
        && deviceIdentityConsistent(deviceHash);

      allow delete: if false;

      // Live/volatile subdoc — presence, nowPlaying, preview.
      // Written by the user's app when an admin is watching;
      // read by admin or the user who owns the parent doc.
      match /live/{doc} {
        allow read: if isOwner() || isOwnerOfDeviceDoc(deviceHash);
        allow create, update: if signedIn() && isOwnerOfDeviceDoc(deviceHash);
        allow create, update: if isOwner();
        allow delete: if false;
      }
    }

    /* =========================
       USERS BY ID — UID → deviceHash mapping
       ========================= */

    match /usersById/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list: if isOwner();

      allow create, update: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "deviceHash", "authUid", "appId", "adminBuild", "updatedAt"
        ])
        && request.resource.data.authUid == request.auth.uid
        && isValidDeviceHashString(request.resource.data.deviceHash);

      allow delete: if signedIn()
        && ("deviceHash" in resource.data)
        && isValidDeviceHashString(resource.data.deviceHash)
        && isOwnerOfDeviceDoc(resource.data.deviceHash);

      allow delete: if isOwner();
    }

    /* =========================
       ANNOUNCEMENTS
       ========================= */

    match /announcements/{id} {
      // Owner sees everything (incl. drafts). Signed-in users may only read
      // ACTIVE announcements: for a list query, Firestore evaluates this rule
      // against each matched doc, so a non-owner query must filter active==true
      // (both client listeners already do `whereEqualTo("active", true)`) — an
      // attempt to list drafts matches an active==false doc and is denied.
      // Requiring signedIn() also blocks unauthenticated scraping (the app is
      // always anon-authed before any Firestore read).
      allow get, list: if isOwner() || (signedIn() && resource.data.active == true);
      allow create, update, delete: if isOwner();
    }

    /* =========================
       RELEASES
       ========================= */

    match /releases/{docId} {
      allow get:  if true;
      allow list: if isOwner();  // owner enumerates for the media-orphan sweep
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly([
          "versionCode", "versionName", "downloadUrl",
          "requiredMinCode", "notes", "bodyDoc",
          "publishedAt", "publishedByDevice"
        ])
        && (request.resource.data.versionCode is int || request.resource.data.versionCode is float)
        && (request.resource.data.downloadUrl is string)
        && request.resource.data.downloadUrl.size() > 0;
      // Owner can delete any release doc. A device may ALSO retract its OWN
      // targeted release (docId == its deviceHash) once it has installed the
      // update — self-cleanup to save space. Scoped via isOwnerOfDeviceDoc so a
      // device can only delete releases/{itsOwnHash}, and "latest" (the global
      // release, a known non-hash id) is explicitly excluded so no client can
      // retract the global release for everyone.
      allow delete: if isOwner()
        || (docId != "latest" && isOwnerOfDeviceDoc(docId));
    }

    /* =========================
       BAN SYSTEM (tri-directional model)
       ========================= */

    match /bannedIdentifiers/{identifier} {
      // get stays signed-in (not owner-only): the client ban check
      // (VrchatBanChecker.checkPhase1/2) must read its OWN deviceHash, authUid,
      // AND vrchatId by exact id. The vrchatId path can't be ownership-verified
      // in rules (no server-side vrchatId->auth mapping), so we can't narrow get
      // to "only your own ids" without breaking new-device/same-VRChat detection.
      // This is acceptable: `list` is owner-only (the collection can't be dumped),
      // the doc payload is only {banId, type, active}, and identifiers are
      // high-entropy (sha256 / Firebase UID / usr_ ids) so blind probing is
      // impractical. A banned user can at most confirm their own already-known
      // flags.
      allow get: if signedIn();
      allow list: if isOwner();
      allow create, update, delete: if isOwner();
    }

    match /bannedRecords/{banId} {
      allow get, list: if isOwner();
      allow create, update, delete: if isOwner();
    }

    /* =========================
       ACCOUNT SESSION LOCK (single-session take-over)
       ========================= */

    // Tiny lock doc keyed by VRChat user id, holding ONLY which device currently
    // "owns" the account. Multiple devices logged into the same VRChat account
    // use it to enforce one-active-device-at-a-time: the newest claimer wins, and
    // the displaced device sees the change via its listener and stops sending.
    match /accounts/{vrchatUserId} {
      // Account centre (§5): the account doc + a per-device membership subcollection
      // (multi-device, replaced the single-session lock). Same bounded threat model
      // as before — a write needs the account's high-entropy usr_ id, and the keys
      // are constrained so no arbitrary data can be injected. get: signed-in (a
      // device reads its own account by exact vrchatUserId, unverifiable in rules).
      // list owner-only so the collection can't be enumerated.
      allow get: if isOwner() || signedIn();
      allow list: if isOwner();
      allow create, update: if isOwner()
        || (signedIn()
            && request.resource.data.keys().hasOnly(['vrchatUserId', 'primaryDeviceHash', 'createdAt', 'updatedAt'])
            && (!('primaryDeviceHash' in request.resource.data)
                || isValidDeviceHashString(request.resource.data.primaryDeviceHash)));
      allow delete: if isOwner() || signedIn();

      // Membership: each device registers its OWN record. Keys constrained; the
      // deviceHash must be a valid hash string. Read by owner or any signed-in
      // member (the Settings account area lists members).
      match /devices/{deviceHash} {
        allow get, list: if isOwner() || signedIn();
        allow create, update: if isOwner()
          || (signedIn()
              && request.resource.data.keys().hasOnly(['deviceHash', 'vrchatUserId', 'role', 'appId', 'localIp', 'addedAt', 'lastSeenAt', 'versionName', 'versionCode'])
              && isValidDeviceHashString(request.resource.data.deviceHash));
        allow delete: if isOwner() || signedIn();
      }
    }

    /* =========================
       LEGACY DEVICE BANS (kept for migration)
       ========================= */

    match /bannedDevices/{deviceHash} {
      allow get: if isOwner()
        || (signedIn()
          && exists(/databases/$(database)/documents/users/$(deviceHash))
          && get(/databases/$(database)/documents/users/$(deviceHash)).data.authUid == request.auth.uid);
      allow list: if isOwner();
      allow create, update, delete: if isOwner();
    }

    /* =========================
       MODERATION EVENTS — audit / ban-evasion
       ========================= */

    match /moderationEvents/{id} {
      allow get, list: if isOwner();

      allow create: if isOwner()
        && request.resource.data.keys().hasOnly([
          "uid", "targetUid", "targetDocId", "targetAuthUid",
          "targetDeviceHash", "action", "reason", "createdAt",
          "byUid", "byDeviceHash", "byAppId",
          "banId", "method", "newVrchatId", "newDeviceHash", "newDisplayName"
        ])
        && (request.resource.data.action is string)
        && (request.resource.data.reason is string || !("reason" in request.resource.data));

      allow update, delete: if false;
    }

    /* =========================
       ACTIONS — admin audit trail
       ========================= */

    match /actions/{id} {
      allow get, list: if isOwner();
      allow create: if isOwner();
      allow update, delete: if false;
    }

    /* =========================
       CONFIG — config/app holds ownerUid + ToS
       ========================= */

    match /config/{docId} {
      allow get: if docId == "app" || (docId == "adminPresence" && signedIn());
      allow list: if false;
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
