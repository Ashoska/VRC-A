rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       Helpers
       ========================= */

    function signedIn() {
      return request.auth != null;
    }

    function ownerUid() {
      return exists(/databases/$(database)/documents/config/app)
        ? get(/databases/$(database)/documents/config/app).data.ownerUid
        : "";
    }

    function isOwner() {
      return signedIn() && ownerUid() == request.auth.uid;
    }

    function isValidDeviceHashString(v) {
      return (v is string) && v.size() >= 16 && v.size() <= 128;
    }

    function ownerOnlyUserKeys() {
      return [
        "warned", "warnReason",
        "banned", "banReason",
        "watcherActiveAt",
        "targetedUpdateUrl", "targetedUpdateNotes"
      ];
    }

    function selfMutableKeys() {
      return [
        "lastSeenAt", "updatedAt",
        "appId", "adminBuild", "versionName", "versionCode",
        "docId", "docIdType",
        "authUid", "uid",
        "currentUid",
        "deviceHash",
        "tosAcceptedVersion", "tosAcceptedAt",
        "displayName",
        "alias",

        // App online status
        "isOnlineInApp",

        // Pinned message (renamed from AFK -- old key names kept for compat)
        "afkEnabled", "afkMessage",
        "afkPreset1", "afkPreset2", "afkPreset3",
        "afkPreset1Name", "afkPreset2Name", "afkPreset3Name",

        // Cycle
        "cycleEnabled", "cycleIntervalSeconds", "cycleLines", "cycleLinesText",
        "cyclePreset1", "cyclePreset2", "cyclePreset3", "cyclePreset4", "cyclePreset5",
        "cyclePreset1Name", "cyclePreset2Name", "cyclePreset3Name",
        "cyclePreset4Name", "cyclePreset5Name",

        // Now Playing
        "spotifyEnabled", "spotifyDemoEnabled", "spotifyPreset",
        "nowPlayingDetected", "nowPlayingIsPlaying",
        "nowPlayingTitle", "nowPlayingArtist",

        // Output
        "activePackage",
        "combinedPreviewText",
        "cycleTrimWarning",
        "cardOrder",
        "dividerConfig",

        // Time
        "timeEnabled", "timeMode",
        "lastReportedTime", "lastTimeUpdateAt",

        // Multi-IP slots
        "ip1Name", "ip1Address",
        "ip2Name", "ip2Address",
        "ip3Name", "ip3Address",
        "activeIpSlot",

        // VRChat identity + presence (written by PipelineService, read by admin)
        "vrchatUserId", "vrchatDisplayName",
        "vrchatState", "vrchatStatus", "vrchatStatusDescription",
        "vrchatWorld", "vrchatLocation",
        "vrchatInstancePlayerCount", "vrchatInstanceCapacity",
        "vrchatPlatform", "vrchatAvatarThumb",
        "vrchatIsOnline",
        "vrchatLastSyncAt", "vrchatAuthCookieValid",

        // Friends cache (kept for cleanup via FieldValue.delete)
        "savedFriendIds", "savedFriendNames",

        // Notification preferences (local only, synced for admin visibility)
        "notifFriendRequest", "notifInvite",
        "notifFriendOnline", "notifFriendOffline",
        "notifUnfriend", "notifGroupEvent",
        "notifGroupAnnouncement"
      ];
    }

    function deviceIdentityConsistent(deviceHash) {
      return request.resource.data.deviceHash == deviceHash
        && isValidDeviceHashString(request.resource.data.deviceHash)
        && (!("docId" in request.resource.data) || request.resource.data.docId == deviceHash)
        && (!("docIdType" in request.resource.data) || request.resource.data.docIdType in ["deviceHash", "authUid_fallback", "authUid"]);
    }

    function publicAuthConsistent() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.authUid == request.auth.uid
        && (!("currentUid" in request.resource.data) || request.resource.data.currentUid == request.auth.uid);
    }

    function isOwnerOfDeviceDoc(deviceHash) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(deviceHash))
        && get(/databases/$(database)/documents/users/$(deviceHash)).data.uid == request.auth.uid;
    }

    /* =========================
       USERS (DOC ID = deviceHash)
       ========================= */

    match /users/{deviceHash} {
      allow get:  if isOwner() || isOwnerOfDeviceDoc(deviceHash);
      allow list: if isOwner();

      allow create: if signedIn()
        && deviceIdentityConsistent(deviceHash)
        && publicAuthConsistent()
        && request.resource.data.keys().hasOnly(selfMutableKeys())
        && !request.resource.data.keys().hasAny(ownerOnlyUserKeys());

      allow update: if signedIn()
        && resource.data.deviceHash == deviceHash
        && deviceIdentityConsistent(deviceHash)
        && publicAuthConsistent()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(selfMutableKeys())
        && !request.resource.data.diff(resource.data).changedKeys().hasAny(ownerOnlyUserKeys());

      // Owner can update any field (ban, warn, edit presets, watcher, targeted updates, etc.)
      allow update: if isOwner()
        && request.resource.data.deviceHash == deviceHash
        && deviceIdentityConsistent(deviceHash);

      allow delete: if false;
    }

    /* =========================
       USERS BY ID
       ========================= */

    match /usersById/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list: if isOwner();

      allow create, update: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "deviceHash", "authUid", "appId", "adminBuild", "updatedAt"
        ])
        && request.resource.data.authUid == request.auth.uid
        && isValidDeviceHashString(request.resource.data.deviceHash);

      allow delete: if signedIn()
        && ("deviceHash" in resource.data)
        && isValidDeviceHashString(resource.data.deviceHash)
        && isOwnerOfDeviceDoc(resource.data.deviceHash);

      allow delete: if isOwner();
    }

    /* =========================
       ANNOUNCEMENTS
       ========================= */

    match /announcements/{id} {
      allow get, list: if true;
      allow create, update, delete: if isOwner();
    }

    /* =========================
       RELEASES
       ========================= */

    match /releases/{docId} {
      allow get:  if true;
      allow list: if false;
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly([
          "versionCode", "versionName", "downloadUrl",
          "requiredMinCode", "notes",
          "publishedAt", "publishedByDevice"
        ])
        && (request.resource.data.versionCode is int || request.resource.data.versionCode is float)
        && (request.resource.data.downloadUrl is string)
        && request.resource.data.downloadUrl.size() > 0;
      allow delete: if isOwner();
    }

    /* =========================
       BAN SYSTEM (new tri-directional model)
       ========================= */

    match /bannedIdentifiers/{identifier} {
      allow get: if signedIn();
      allow list: if isOwner();
      allow create, update, delete: if isOwner();
    }

    match /bannedRecords/{banId} {
      allow get, list: if isOwner();
      allow create, update, delete: if isOwner();
    }

    /* =========================
       LEGACY DEVICE BANS (kept for migration, no new writes)
       ========================= */

    match /bannedDevices/{deviceHash} {
      allow get: if isOwner()
        || (signedIn()
          && exists(/databases/$(database)/documents/users/$(deviceHash))
          && get(/databases/$(database)/documents/users/$(deviceHash)).data.authUid == request.auth.uid);
      allow list: if isOwner();
      allow create, update, delete: if isOwner();
    }

    /* =========================
       MODERATION EVENTS
       ========================= */

    match /moderationEvents/{id} {
      allow get, list: if isOwner();

      allow create: if isOwner()
        && request.resource.data.keys().hasOnly([
          "uid", "targetUid", "targetDocId", "targetAuthUid",
          "targetDeviceHash", "action", "reason", "createdAt",
          "byUid", "byDeviceHash", "byAppId",
          "banId", "method", "newVrchatId", "newDeviceHash", "newDisplayName"
        ])
        && (request.resource.data.action is string)
        && (request.resource.data.reason is string || !("reason" in request.resource.data));

      allow update, delete: if false;
    }

    /* =========================
       ACTIONS / AUDIT TRAIL
       ========================= */

    match /actions/{id} {
      allow get, list: if isOwner();
      allow create: if isOwner();
      allow update, delete: if false;
    }

    /* =========================
       CONFIG
       ========================= */

    match /config/{docId} {
      allow get: if docId == "app";
      allow list: if false;
      allow create, update: if isOwner();
      allow delete: if false;
    }

    /* =========================
       DEVICES
       ========================= */

    match /devices/{id} {
      allow read, write: if isOwner();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
