<?xml version="1.0" encoding="utf-8"?>
<!--
  Headset (Meta Quest / Horizon OS) flavor manifest overlay. Merged OVER the
  main manifest (flavor manifests win), so this only adds/overrides what the
  Quest build needs — the phone/admin builds are untouched.

  M1 (flavor scaffold): force the launcher activity into LANDSCAPE so the app
  opens in Quest's 16:10 "monitor" panel (default 1024x640 dp) instead of a
  tall phone shape.

  resizeableActivity stays "true": the app must FILL whatever panel size Horizon
  gives it. Previously this set android:resizeableActivity="false" + min/max
  AspectRatio to "lock" the panel, but Horizon OS owns 2D-panel resize and
  ignores those flags — and worse, a NON-resizable activity gets letterboxed:
  when the user enlarged the panel, Android rendered the app at its fixed size
  top-anchored and padded the rest with the grey window background (the "big
  empty grey area below the nav bar when resized" bug). The panel is fixed with
  the Horizon flags on MainActivity below instead, and FixedPanel (VrcaTheme)
  keeps the 1024x640 layout at any size Horizon still gives it: a resize zooms.
  The base MainActivity already declares configChanges for screenSize/
  screenLayout/smallestScreenSize, so a resize relayouts in place (no Activity
  recreation / flicker while dragging). screenOrientation stays landscape so it
  opens in the monitor shape.

  MANAGE_EXTERNAL_STORAGE: the headset build reads VRChat's output log to build
  the instance roster (InstanceRosterManager). Only the headset flavor requests
  it — the public/admin builds never touch the log reader.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- All-files access, headset-only: read VRChat's output log for the roster. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Microphone, headset-only: offline voice-to-text dictation into the chatbox
         (sherpa-onnx). Runtime-requested. FOREGROUND_SERVICE_MICROPHONE: while dictating,
         DictationService (type microphone) keeps the mic live once you switch to VRChat;
         without it Android silenced the mic after about one phrase in the background. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- OSC push (MdnsAnnouncer): receive mDNS queries + send our own announcements
         on the Quest's Wi-Fi. Normal permission, no prompt. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- usesCleartextTraffic: VRChat's OSCQuery service is plain HTTP on the LAN
         (e.g. http://192.168.0.89:45631). Android blocks cleartext by default, so
         reading avatar params over OSCQuery needs this. Headset-only (the phone/
         admin builds keep cleartext BLOCKED); it does NOT downgrade any existing
         https:// call — it only permits http when we explicitly use it. -->
    <!-- No android:banner: the Quest library tile is NOT driven by the APK — QGO (Quest
         Games Optimizer) and the stock Meta library use their OWN thumbnail databases (or
         the square icon as fallback) and ignore a manifest banner. A proper QGO tile needs
         a custom cover set in QGO / submitted to its database; a store tile needs the Meta
         dashboard cover art. So the banner PNG was dropped to save headset APK space. -->
    <!-- The speech engine's native libs are stored COMPRESSED (legacy packaging, set for the
         headset variant in app/build.gradle androidComponents; AGP 9 refuses the old
         android:extractNativeLibs="true" here). -->
    <application
        android:resizeableActivity="true"
        android:usesCleartextTraffic="true"
        tools:node="merge">

        <!-- VRChat OSC bridge (com.vrca.osc.OscBridge): its own small process so VRChat's
             push survives the main app being swiped, crashing or OS-killed (VRChat stops
             sending for its session when our receive socket closes). Not stopped by a
             swipe; stops itself 10 min after the main app is gone and VRChat is silent. -->
        <service
            android:name="com.vrca.osc.OscBridgeService"
            android:process=":oscbridge"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Fixed panel (user request: the window shouldn't be resizable). Horizon lets users
             resize any Android panel (Meta's docs: "Users can resize panels freely"; no lock
             exists), so: the default size (Meta's <layout>) is also the MINIMUM, so the panel
             can only be made bigger, never smaller than 1024x640; a bigger panel just zooms the
             app's 1024x640 layout (FixedPanel). The com.oculus.vrshell.* flags (not in Meta's
             public docs, seen in Meta's forum answers and apps' manifests) were device-tested
             on 2026-10-16: Horizon ignores supports_free_resizing=false (the panel still
             resized). Kept in case a later Horizon honours them; harmless otherwise. -->
        <activity
            android:name=".app.MainActivity"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            tools:node="merge">
            <layout
                android:defaultWidth="1024dp"
                android:defaultHeight="640dp"
                android:minWidth="1024dp"
                android:minHeight="640dp" />
            <meta-data
                android:name="com.oculus.vrshell.supports_free_resizing"
                android:value="false" />
            <meta-data
                android:name="com.oculus.vrshell.free_resizing_lock_aspect_ratio"
                android:value="true" />
        </activity>

        <!-- Runs only while dictation is on (see DictationService). -->
        <service
            android:name="com.vrca.speech.DictationService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>
