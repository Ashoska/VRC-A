<?xml version="1.0" encoding="utf-8"?>
<!--
  Headset (Meta Quest / Horizon OS) flavor manifest overlay. Merged OVER the
  main manifest (flavor manifests win), so this only adds/overrides what the
  Quest build needs — the phone/admin builds are untouched.

  M1 (flavor scaffold): force the launcher activity into LANDSCAPE so the app
  opens in Quest's 16:10 "monitor" panel (default 1024x640 dp) instead of a
  tall phone shape. Content stays width-responsive (see VrcaScreen framing) so
  a user resizing the panel toward the 384x500 dp minimum never looks broken.

  Lock the panel to a FIXED size so the user cannot resize/reshape it (which
  was reshuffling the layout): android:resizeableActivity="false" tells
  Horizon OS to open the app in a single fixed panel with no resize grip.
  Belt-and-braces: the same flag on <application>, plus the Meta-specific
  <meta-data com.oculus.vr.focusaware /> so the fixed panel keeps input focus.
  (Honest caveat: Horizon OS ultimately owns window management; if a future
  Horizon build ignores resizeableActivity for 2D panels, the width-responsive
  framing in VrcaScreen is still the fallback so nothing looks broken.)

  Deferred to M2 (log reader): MANAGE_EXTERNAL_STORAGE / SAF for reading
  VRChat's output logs, and any Horizon-Store submission manifest entries.
  Not added here — unused permissions would only complicate store review.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application android:resizeableActivity="false" tools:node="merge">
        <activity
            android:name=".app.MainActivity"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            tools:node="merge" />
    </application>

</manifest>
