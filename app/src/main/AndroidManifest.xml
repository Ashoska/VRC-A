<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Boot receiver for pipeline service restart -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Package visibility (Android 11+/API 30+). Without this, getApplicationIcon()
      for the detected media app throws NameNotFoundException unless we happen to
      be mid-interaction with its MediaSession — so the Now Playing source icon
      resolved only intermittently and otherwise fell back to a generic glyph.
      Declare the known media apps explicitly, plus any app exposing a
      MediaBrowserService so "other media apps are always allowed" resolve too.
    -->
    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.youtube.music" />
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <application
        android:name="com.vrca.app.VrcaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="VRC-A"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chatbox"
        tools:targetApi="31">

        <!-- Overlay -->
        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Keep-alive Foreground Service -->
        <service
            android:name=".keepalive.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Now Playing listener.
             android:label is REQUIRED for the Settings deep-link to work on
             Horizon OS (Quest): the notification-access settings screen builds
             its list of listener entries keyed by the flattened component, and
             an UNLABELED listener is not rendered as a targetable preference —
             so the :settings:fragment_args_key deep-link (notificationAccessIntent)
             can't scroll to our entry and Horizon falls back to the top-level
             settings. VRC-NEXUS labels its listener with @string/app_name for
             exactly this reason (verified by decompiling their APK); matching it
             makes our "Notification access" button land on VRC-A's own page. -->
        <service
            android:name=".nowplaying.NowPlayingListenerService"
            android:label="@string/app_name"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- VRChat WebSocket pipeline service (persistent, survives app close) -->
        <service
            android:name=".vrchat.VrchatPipelineService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- Discord Rich Presence service -->
        <service
            android:name=".discord.DiscordRpcService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Boot receiver: restarts pipeline after device reboot -->
        <receiver
            android:name=".vrchat.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".vrchat.NotificationActionReceiver"
            android:exported="false" />

        <!-- Device shutdown: cleanly close the Discord gateway so the RPC presence
             disappears when the device powers off (a Quest full-power-off otherwise
             leaves the socket un-closed and Discord keeps showing the RPC). -->
        <receiver
            android:name=".discord.DeviceShutdownReceiver"
            android:exported="false">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.ACTION_SHUTDOWN" />
                <action android:name="android.intent.action.QUICKBOOT_POWEROFF" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWEROFF" />
            </intent-filter>
        </receiver>

        <!-- Local reminder for events the user signed up for (Add to Calendar) -->
        <receiver
            android:name=".vrchat.EventReminderReceiver"
            android:exported="false" />

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:label="VRC-A"
            android:theme="@style/Theme.Chatbox"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Spotify OAuth redirect catcher (vrca://spotify-callback). -->
        <activity
            android:name="com.vrca.spotify.SpotifyRedirectActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vrca" android:host="spotify-callback" />
            </intent-filter>
        </activity>

        <!-- FileProvider for APK installs -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>

</manifest>
