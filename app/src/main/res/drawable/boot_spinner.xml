<?xml version="1.0" encoding="utf-8"?>
<!-- The boot screen's "working" spinner as an AnimatedVectorDrawable: Android runs these on the
     RenderThread, so it keeps turning even while the app's main thread is busy (Compose's own
     CircularProgressIndicator froze whenever boot work blocked it; user's Quest video). An arc
     that grows and shrinks while the whole thing turns. Tinted from code (ImageView tint). -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group
                android:name="spin"
                android:pivotX="12"
                android:pivotY="12">
                <path
                    android:name="arc"
                    android:pathData="M12,1.6 A10.4,10.4 0 1,1 11.99,1.6"
                    android:strokeColor="#FFFFFFFF"
                    android:strokeWidth="3.2"
                    android:strokeLineCap="round"
                    android:trimPathStart="0"
                    android:trimPathEnd="0.1" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="spin">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1100"
                android:interpolator="@android:anim/linear_interpolator"
                android:propertyName="rotation"
                android:repeatCount="infinite"
                android:valueFrom="0"
                android:valueTo="360" />
        </aapt:attr>
    </target>
    <target android:name="arc">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="800"
                android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                android:propertyName="trimPathEnd"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:valueFrom="0.1"
                android:valueTo="0.75"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
