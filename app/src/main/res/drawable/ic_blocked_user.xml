<!-- "Blocked" active-state glyph for the roster block button: a no-entry circle (with a
     diagonal slash carved via evenOdd) plus a minus badge at the bottom-right, matching
     VRChat's own blocked-user mark. Single fill colour so Icon(tint=…) themes it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Circle with the diagonal slash carved out. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M1,9.5 a8.5,8.5 0 1,0 17,0 a8.5,8.5 0 1,0 -17,0 Z
                          M3,5 L5,3 L16,14 L14,16 Z" />
    <!-- Minus badge (filled circle with a horizontal notch). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M13,18 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z
                          M15.3,17 L20.7,17 L20.7,19 L15.3,19 Z" />
</vector>
